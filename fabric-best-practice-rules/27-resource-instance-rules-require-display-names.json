{
  "$schema": "../.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "API_RESOURCE_INSTANCE_RULES_REQUIRE_DISPLAYNAMES",
      "name": "Resource Instance Rules Require Display Names",
      "description": "Returns resource IDs where displayName is null, empty, or a generic placeholder. WARNING: This rule was AI-generated and is untested.",
      "itemType": "none",
      "test": [
        {
          "let": [
            {
              "response": {
                "apiget": [
                  "https://api.fabric.microsoft.com/v1/workspaces/{context-fabricworkspace}/networking/communicationpolicy/inbound/azureresources"
                ]
              },
              "rules": {
                "query": [
                  { "var": "response" },
                  { "path": "$.rules[*]" }
                ]
              }
            },
            {
              "map": [
                {
                  "filter": [
                    { "var": "rules" },
                    {
                      "or": [
                        { "isnullorempty": [ { "var": "displayName" } ] },
                        {
                          ">": [
                            {
                              "count": [
                                {
                                  "regexextract": [
                                    { "var": "displayName" },
                                    "(?i)^(rule|test|new rule)$"
                                  ]
                                }
                              ]
                            },
                            0
                          ]
                        }
                      ]
                    }
                  ]
                },
                { "var": "resourceId" }
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}
