{
  "$schema": "../.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "API_RESOURCE_INSTANCE_RULES_APPROVED_SUBSCRIPTIONS",
      "name": "Resource Instance Rules Use Only Approved Subscriptions",
      "description": "Returns resource IDs that do not contain an approved subscription GUID segment.",
      "itemType": "none",
      "test": [
        {
          "let": [
            {
              "response": {
                "apiget": [
                  "https://api.fabric.microsoft.com/v1/workspaces/{context-fabricworkspace}/networking/communicationpolicy/inbound/azureresources"
                ]
              },
              "rules": {
                "query": [
                  { "var": "response" },
                  { "path": "$.rules[*]" }
                ]
              }
            },
            {
              "map": [
                {
                  "filter": [
                    { "var": "rules" },
                    {
                      "and": [
                        {
                          "==": [
                            {
                              "count": [
                                {
                                  "regexextract": [
                                    { "var": "resourceId" },
                                    "/subscriptions/(11111111-1111-1111-1111-111111111111|22222222-2222-2222-2222-222222222222)/"
                                  ]
                                }
                              ]
                            },
                            0
                          ]
                        },
                        {
                          "!": [
                            {
                              "isnullorempty": [
                                { "var": "resourceId" }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                { "var": "resourceId" }
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}
